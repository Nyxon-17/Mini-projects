<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <h1>All posts</h1>
    <button class="newPost">
        <a href="http://localhost:3000/post/new">Create a new post</a>
    </button>
    <%for(post of posts){%>
        <div class="postBox">
            <h1>@<%=post.username%>
            </h1>
            <p>
                <%=post.content%>
            </p>
            <a href="http://localhost:3000/post/Show/<%= post.id%>">see more</a>
        </div>
        <%}%>
</body>

</html>